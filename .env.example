# Copy this to .env (Compose reads .env automatically). .env is gitignored.
#
# Your Docker Hub username, lowercase. Your images are named <user>/paystream-*.
DOCKERHUB_USER=your-dockerhub-username
# The tag to build/pull. Use a real version or commit in production; latest locally.
TAG=latest
# Database password. The default matches the app's seed and config.
POSTGRES_PASSWORD=paystream
