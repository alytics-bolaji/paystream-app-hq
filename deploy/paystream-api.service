[Unit]
Description=Paystream wallet API (Node)
# The database and cache run as Docker containers, so we wait for Docker.
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=paystream
WorkingDirectory=/opt/paystream/backend/current
EnvironmentFile=/opt/paystream/backend/shared/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
