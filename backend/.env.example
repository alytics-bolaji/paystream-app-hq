# Backend configuration. Copy to .env and adjust for your environment.
# On the EC2 box this lives at /opt/paystream/backend/shared/.env

PORT=3000
DATABASE_URL=postgres://paystream:paystream@localhost:5432/paystream
REDIS_URL=redis://localhost:6379
CACHE_TTL=60

# Who may call the API from a browser. In production the frontend is served
# from the same host via Nginx, so "*" is fine here; tighten it if you like.
CORS_ORIGIN=*
